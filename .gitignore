target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing a top-level application or tool, you should keep it.
#   If you're a library, you should ignore it.
# Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock can be either ignored or checked-in, depending on the case.
# poetry.lock

# pdm
#   Similar to Pipenv, pdm.lock can be either ignored or checked-in, depending on the case.
# pdm.lock

# virtualenv
venv/
ENV/
env/
.venv/
.env/
.venv*/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype
.pytype/

# Cython debug symbols
cython_debug/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE config
.idea/
.vscode/
*.swp
*.swo

# Large files / datasets (except pruned showcase images)
# Note: models/ and dataset/images/ are kept because they are pruned and showcase-ready.
# If there are huge temp/scratch/zip files, ignore them:
*.zip
*.tar.gz
*.tgz
